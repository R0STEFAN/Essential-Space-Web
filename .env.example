# Essential Space Web - Environment Configuration for Coolify

# Required: Random secret key for signing session JWTs (generate 64 chars)
SESSION_SECRET=your-random-session-secret-generate-with-openssl-rand-hex-32

# Path to persistent data storage (mounted as volume in Docker)
DATA_DIR=/app/data

# Port to bind
PORT=3000

# Base API endpoint for Nothing OS Essential Space cloud
NOTHING_API_URL=https://essential-space.nothingtech.link/essentialSpace

# Nothing Space Client API Key (from official Nothing Phone APK)
NOTHING_API_KEY=ZNtCkkSHqahusjfyouYxeaHUryeqKNaG

# Firebase Web Client API Key
NEXT_PUBLIC_FIREBASE_API_KEY=
